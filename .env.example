# FakeSpotter environment configuration
# Copy to .env and fill in your values

# Cryptographic signing key for Forensic Certificates
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FAKESPOTTER_SECRET=change-me-to-a-strong-random-secret

# The server always speaks MCP over streamable HTTP (path /mcp) on $PORT.
# Default 8081; the Docker image sets PORT=8000 and Cloud Run injects its own.
# Leave it unset when using the Docker image with -p 8000:8000.
# PORT=8081

# Temporary files directory (created automatically)
FAKESPOTTER_TMP=/tmp/fakespotter
